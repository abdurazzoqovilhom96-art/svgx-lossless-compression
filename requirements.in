# Direct Python dependencies. requirements.lock is generated by pip-tools (pip-compile
# --generate-hashes) with packages uploaded before the pin cutoff in config/toolchain.toml.
brotli          # reference decoder sections + independent Brotli decode check
numpy           # paired bootstrap (PCG64)
matplotlib      # offline SVG/PDF figures
psutil          # machine inventory / process-tree memory fallback
pytest          # test runner
pip-tools       # lockfile generation
